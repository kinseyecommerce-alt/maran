# AlgoTrader Pro v4 — environment template
# Copy to .env: cp .env.example .env
# All credentials are optional for PAPER mode. Fill in real values only for LIVE mode.

# ─────────────────────────────────────────────
# TRADING MODE  (PAPER is safe default — no real orders)
# ─────────────────────────────────────────────
TRADING_MODE=PAPER

# ─────────────────────────────────────────────
# APP SECURITY  (required — generate random values for production)
# ─────────────────────────────────────────────
# Minimum 32 characters. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-32-char-secret-key-here
JWT_EXPIRE_HOURS=8

# Dashboard login (plain password — only used when ADMIN_PASSWORD_HASH is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@786
# bcrypt hash — takes precedence over ADMIN_PASSWORD when set (auto-filled by setup-vps.sh)
ADMIN_PASSWORD_HASH=

# X-API-Key for REST endpoints (generate: python -c "import secrets; print(secrets.token_hex(24))")
API_KEY=change-me-api-key
KILL_SWITCH_RESET_SECRET=change-me-kill-switch-secret

# ─────────────────────────────────────────────
# ZERODHA KITE  (leave blank for PAPER mode)
# ─────────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
KITE_REDIRECT_URL=http://localhost:8000/auth/kite/callback

# ─────────────────────────────────────────────
# ANTHROPIC (Claude AI trade gate — optional in PAPER mode)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Disable Claude gate locally so paper trades are not blocked waiting for an API key
USE_CLAUDE_TRADE_GATE=false

# ─────────────────────────────────────────────
# TRUEDATA (leave blank to use GBM paper simulator)
# ─────────────────────────────────────────────
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
USE_TRUEDATA_WEBSOCKET=false
USE_TRUEDATA_HISTORICAL=false
USE_TRUEDATA_OPTIONS=false

# ─────────────────────────────────────────────
# RISK LIMITS
# ─────────────────────────────────────────────
TOTAL_CAPITAL=500000.0
MAX_DAILY_LOSS=5000.0
MAX_OPEN_POSITIONS=5
MAX_POSITION_SIZE=50000.0
STOP_LOSS_PCT=1.5
TARGET_PCT=3.0
SQUAREOFF_TIME=15:10

# ─────────────────────────────────────────────
# CAPITAL ALLOCATION
# ─────────────────────────────────────────────
INTRADAY_CAPITAL_PCT=40.0
SWING_CAPITAL_PCT=25.0
OPTIONS_CAPITAL_PCT=25.0
FUTURES_CAPITAL_PCT=10.0
MAX_INTRADAY_POSITIONS=5
MAX_SCALPING_POSITIONS=5
MAX_SWING_POSITIONS=3

# ─────────────────────────────────────────────
# BACKTEST
# ─────────────────────────────────────────────
SKIP_STARTUP_BACKTEST=true
BT_LOOKBACK_DAYS=730
BT_MIN_WIN_RATE=55.0
BT_MIN_SHARPE=1.0
BT_MAX_DRAWDOWN_PCT=15.0
BT_MIN_TRADES=20
BT_MIN_CALMAR=0.5
BT_WF_FOLDS=12
BT_REQUIRE_MC_PASS=false

# ─────────────────────────────────────────────
# INTELLIGENCE
# ─────────────────────────────────────────────
CLAUDE_GATE_MODEL=claude-sonnet-4-6
CLAUDE_GATE_THRESHOLD=30
MASTER_REVIEW_MODEL=claude-opus-4-8
SIGNAL_ENGINE_MODEL=claude-opus-4-8
USE_EXTENDED_THINKING=false
GATE_THINKING_BUDGET=2000
GATE_API_TIMEOUT=5.0
GATE_BYPASS_MIN_SCORE=7
USE_MULTI_TIMEFRAME=true
USE_KELLY_SIZING=true
USE_ATR_SIZING=true
RISK_PER_TRADE_PCT=0.5
USE_CONVICTION_SIZING=true

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# In production set to your Droplet IP or domain (auto-set by setup-vps.sh)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# ─────────────────────────────────────────────
# AUTO-START AGENTS (DigitalOcean / server deployment)
# ─────────────────────────────────────────────
# Comma-separated agent names to start automatically at 9:16 AM IST on market days
AUTO_START_STRATEGIES=
# Comma-separated symbols for the auto-started agents (leave blank to use bhavcopy scanner)
AUTO_START_WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK

# ─────────────────────────────────────────────
# OPTIONAL INTEGRATIONS (leave blank to disable)
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# ALTERNATE BROKERS (leave blank if using Zerodha)
# ─────────────────────────────────────────────
ACTIVE_BROKER=zerodha
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URL=
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
KOTAK_ACCESS_TOKEN=
KOTAK_SID=
KOTAK_MOBILE_NUMBER=
KOTAK_PASSWORD=

# ─────────────────────────────────────────────
# PERSISTENCE (leave blank to use SQLite default)
# ─────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=

# ─────────────────────────────────────────────
# BLACK SWAN VETERAN MODE
# ─────────────────────────────────────────────
BLACK_SWAN_VIX_ZSCORE=3.0
BLACK_SWAN_PRICE_DROP_PCT=3.0
BLACK_SWAN_EXIT_TIME=14:30
BLACK_SWAN_IV_RANK_MIN=75.0
BLACK_SWAN_VOLUME_MULT=3.0

# ─────────────────────────────────────────────
# IP WHITELIST (empty = all IPs allowed; set your server IP in production)
# ─────────────────────────────────────────────
SEBI_WHITELISTED_IPS=

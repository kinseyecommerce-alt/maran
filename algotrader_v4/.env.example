# ── AlgoTrader Pro v4 — environment template ──────────────────────────────────
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ── Security (REQUIRED for production) ────────────────────────────────────────
# Random secret used to sign JWT tokens (browser login). Min 32 chars.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# API key required in X-API-Key header for all mutating endpoints.
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
API_KEY=

# Separate secret needed to reset the SEBI kill switch (cannot be the same as API_KEY).
KILL_SWITCH_RESET_SECRET=

# ── App login ──────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Set a bcrypt hash (preferred) OR plain password (dev only).
# Hash: python deploy/gen-password-hash.py yourpassword
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=  # plain fallback — do not use in production

# ── Zerodha KiteConnect ────────────────────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
# Access token is refreshed daily via /auth/kite/callback or kite_auto_login.py
KITE_ACCESS_TOKEN=

# Kite auto-login via Playwright — enables lights-out 08:50 IST daily token refresh
# and the manual POST /auth/kite/refresh endpoint.
KITE_USER_ID=           # Zerodha client ID e.g. AB1234
KITE_PASSWORD=          # Zerodha login password
# Base32 seed shown when you enable TOTP in Zerodha Console → My Profile → 2FA
# This is NOT the 6-digit OTP — it's the text seed like JBSWY3DPEHPK3PXP
KITE_TOTP_SECRET=
# Must match the redirect URL set in your Kite app at developers.kite.trade
KITE_REDIRECT_URL=      # e.g. http://localhost:8000/auth/kite/callback

# ── Anthropic (Claude trade gate) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── TrueData (optional live tick / options data feed) ─────────────────────────
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
USE_TRUEDATA_WEBSOCKET=false
USE_TRUEDATA_HISTORICAL=false
USE_TRUEDATA_OPTIONS=false

# ── Telegram alerts (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── n8n webhook integration (optional) ────────────────────────────────────────
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=     # HMAC-SHA256 signing secret for inbound webhooks

# ── Trading mode ──────────────────────────────────────────────────────────────
# PAPER = simulated orders, no real money. LIVE = real Kite orders.
TRADING_MODE=PAPER

# Skip per-symbol backtests at bot startup (use pre-learned approved_symbols.json).
# Set true in PAPER mode or when TrueData/YFinance is unavailable.
SKIP_STARTUP_BACKTEST=false

# ── Risk limits ───────────────────────────────────────────────────────────────
MAX_DAILY_LOSS=5000.0
MAX_POSITION_SIZE=50000.0
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=1.5
TARGET_PCT=3.0
SQUAREOFF_TIME=15:10

# ── Capital allocation ────────────────────────────────────────────────────────
TOTAL_CAPITAL=500000.0
INTRADAY_CAPITAL_PCT=40.0
SWING_CAPITAL_PCT=25.0
OPTIONS_CAPITAL_PCT=25.0
FUTURES_CAPITAL_PCT=10.0

# ── Phase 1: Transaction costs + slippage (P&L accuracy) ─────────────────────
# Deduct Zerodha brokerage/STT/GST/stamp from realised P&L in PAPER + LIVE.
USE_TRANSACTION_COSTS=true
# Apply ATR-proportional market slippage to PAPER fills (3/7/15 bps by volume tier).
APPLY_SLIPPAGE=true
# Override slippage with a fixed bps value; 0 = use volume-tier table.
SLIPPAGE_BPS_OVERRIDE=0
# Apply Claude gate's size_factor to position quantity (scales qty 0.25–1.0×).
USE_KELLY_SIZING=true
# Size positions by half-Kelly fraction of total capital (uses adaptive win stats).
USE_KELLY_CAPITAL_SIZING=false

# ── Phase 2: Backtest rigor ────────────────────────────────────────────────────
# Walk-forward lookback window in days (730 = 2 years of history).
BT_LOOKBACK_DAYS=730
# Number of walk-forward folds; 12 gives robust out-of-sample validation.
BT_WF_FOLDS=12
# Minimum out-of-sample trades required per fold to count the fold.
BT_MIN_OOS_TRADES=15
# Monte Carlo permutations for significance testing (Sharpe + drawdown).
BT_MC_PERMUTATIONS=1000
# Require Monte Carlo p-value < 0.05 as hard gate before approving a symbol.
BT_REQUIRE_MC_PASS=false

# ── Phase 3: Intelligence ──────────────────────────────────────────────────────
# Max concurrent open positions in the same NIFTY sector (correlation guard).
MAX_POSITIONS_PER_SECTOR=2
# Minimum 20-trade rolling Sharpe; below this an agent alert is broadcast.
MIN_ROLLING_SHARPE=0.5
# Use ATR-based position sizing (risk_per_trade_pct% of capital per 1-ATR move).
USE_ATR_SIZING=true
RISK_PER_TRADE_PCT=0.5

# ── Phase 4: Persistence backends ─────────────────────────────────────────────
# Empty = SQLite in-memory fallback (works with no external dependencies).
# PostgreSQL (asyncpg driver): postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=
# Redis (optional): redis://localhost:6379/0 — used for activity log + pub/sub
REDIS_URL=

# ── SEBI IP whitelist ─────────────────────────────────────────────────────────
# Comma-separated static IPs allowed to place orders / trigger kill-switch.
# Empty = whitelist disabled (all client IPs accepted — only safe in PAPER mode).
# In production set this to your server's static outbound IP.
SEBI_WHITELISTED_IPS=

# ── CORS origins (comma-separated) ────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

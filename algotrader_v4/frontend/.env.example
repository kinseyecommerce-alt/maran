# Frontend build-time configuration (Vite reads VITE_* vars).
# Copy to .env.local for local dev or set in your host (Vercel/Railway) dashboard.

# Base URL of the AlgoTrader FastAPI backend.
# Dev default (if unset) is http://localhost:8000 — see src/store/index.ts.
# In production set this to your deployed backend, e.g. https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8000

APP_ENV=development
APP_NAME=EMA_RSI_INTRADAY_ALGO
APP_SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=postgresql+asyncpg://algo:algo@localhost:5432/ema_rsi_algo
REDIS_URL=redis://localhost:6379/0
TIMEZONE=Asia/Kolkata

# ── Trading mode ──────────────────────────────────────────────────────────
# SIMULATION is the only safe default. LIVE requires ALLOW_LIVE_TRADING=true
# AND every readiness gate green AND explicit operator confirmation.
TRADING_MODE=SIMULATION
ALLOW_LIVE_TRADING=false

# ── Broker (Zerodha Kite Connect) — never commit real values ─────────────
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_REDIRECT_URL=
ZERODHA_USER_ID=

# ── Capital & risk ────────────────────────────────────────────────────────
DEFAULT_CAPITAL=1000000
DEFAULT_RISK_PERCENTAGE=0.50
MAXIMUM_STOP_PERCENTAGE=1.0
MAX_DAILY_LOSS_PERCENTAGE=1.5
MAX_TRADES_PER_DAY=5
MAX_CONSECUTIVE_LOSSES=3
MAX_SIMULTANEOUS_POSITIONS=3
MAX_TOTAL_OPEN_RISK_PERCENTAGE=1.5

# ── Session times (Asia/Kolkata) ─────────────────────────────────────────
MARKET_OPEN_TIME=09:15
NEW_ENTRY_START_TIME=09:21
NEW_ENTRY_CUTOFF_TIME=14:45
FORCED_SQUARE_OFF_TIME=15:15
FINAL_SQUARE_OFF_TIME=15:25

# ── Trade management (R multiples) ───────────────────────────────────────
BREAK_EVEN_TRIGGER_R=1.5
PARTIAL_EXIT_TRIGGER_R=2.0
PARTIAL_EXIT_PERCENTAGE=50
FINAL_TARGET_R=3.0

# ── Setup tolerances ─────────────────────────────────────────────────────
EMA_TOUCH_TOLERANCE_MODE=percentage
EMA_TOUCH_TOLERANCE_VALUE=0.10
STOP_BUFFER_MODE=atr
STOP_BUFFER_VALUE=0.10
TRAILING_METHOD=previous_completed_candle
TRAILING_START_R=2.0

# ── Strategy / risk config file locations ────────────────────────────────
STRATEGY_CONFIG_PATH=config/strategy.default.yaml
RISK_CONFIG_PATH=config/risk.default.yaml

# ── Paste these into Railway → your service → Variables ──────────────────────
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET_KEY=<generate-32-char-hex>
API_KEY=<generate-24-char-hex>
KILL_SWITCH_RESET_SECRET=<your-reset-secret>

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<bcrypt-hash-of-your-password>

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

ANTHROPIC_API_KEY=

TRADING_MODE=PAPER

MAX_DAILY_LOSS=5000.0
MAX_POSITION_SIZE=50000.0
MAX_OPEN_POSITIONS=5
TOTAL_CAPITAL=500000.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

